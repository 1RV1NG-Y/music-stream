{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "music-stream",
  "version": "0.1.0",
  "identifier": "app.musicstream",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5190",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "music-stream",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: art: http://art.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Play your phone's music on your PC over the local network",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
