{
  "name": "music-stream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Play the music on your phone from your PC (Linux, Windows), streamed over the local network.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:build": "node scripts/build-apk.mjs",
    "install:linux": "tauri build --no-bundle && node scripts/install-linux.mjs"
  },
  "dependencies": {
    "@tauri-apps/plugin-barcode-scanner": "^2.5.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.3.0"
  }
}
